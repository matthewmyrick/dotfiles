# FONT CONFIGURATION
font-family = "FiraCode Nerd Font"
font-size = 16
font-feature = -calt

# THEME
# theme = Espresso

palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#a6adc8
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#bac2de
background = 1e1e2e
foreground = cdd6f4
cursor-color = f5e0dc
cursor-text = 1e1e2e
selection-background = 353749
selection-foreground = cdd6f4

# TABS
# Tab location at the top
gtk-tabs-location = top

# WINDOW APPEARANCE
window-decoration = true
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-padding-color = background

# COLORS & BORDERS
selection-background = #89b4fa
selection-foreground = #1e1e2e
cursor-style = block
cursor-style-blink = true

# OPACITY
background-opacity = 0.98

# SCROLLBACK
scrollback-limit = 10000

# MISC FEATURES
copy-on-select = true
focus-follows-mouse = false
mouse-hide-while-typing = true

# MACOS SPECIFIC
macos-option-as-alt = true
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = visible
macos-icon = custom-style

# TERMINAL BEHAVIOR
confirm-close-surface = false
clipboard-paste-protection = false
clipboard-trim-trailing-spaces = true
