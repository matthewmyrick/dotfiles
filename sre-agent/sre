#!/bin/bash

# SRE Agent - Incident Response & RCA Tool
# Usage:
#   sre --analyze --service <service-name> [--timeframe <duration>]
#   sre --analysis --service <service-name>

set -e

# Configuration
SRE_CONFIG_DIR="$HOME/.config/sre-agent"
SERVICES_DIR="$SRE_CONFIG_DIR/services"
ANALYSIS_DIR="$SRE_CONFIG_DIR/analysis"
AWS_PROFILE="hadrius-dev"
DEFAULT_TIMEFRAME="1h"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Print colored output
print_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
print_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
print_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
print_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Show usage
usage() {
    cat << EOF
SRE Agent - Incident Response & RCA Tool

USAGE:
    sre --analyze --service <service-name> [--timeframe <duration>]
    sre --analysis --service <service-name>
    sre --list

COMMANDS:
    --analyze       Run Claude to analyze the service and generate an RCA report
    --analysis      View the existing analysis report for a service
    --list          List available services

OPTIONS:
    --service, -s   The service to analyze (required for analyze/analysis)
    --timeframe, -t Timeframe to analyze (default: 1h)
                    Examples: 30m, 1h, 2h, 6h, 12h, 24h
    --help, -h      Show this help message

EXAMPLES:
    sre --analyze --service django-api
    sre --analyze --service django-api --timeframe 2h
    sre --analysis --service django-api
    sre --list

EOF
    exit 0
}

# Parse timeframe to minutes for AWS queries
parse_timeframe_to_minutes() {
    local timeframe="$1"
    local value="${timeframe%[mh]}"
    local unit="${timeframe: -1}"

    case "$unit" in
        m) echo "$value" ;;
        h) echo $((value * 60)) ;;
        *) echo "60" ;; # Default 1 hour
    esac
}

# Check AWS authentication
check_aws_auth() {
    print_info "Checking AWS authentication for profile: $AWS_PROFILE"

    if aws sts get-caller-identity --profile "$AWS_PROFILE" &>/dev/null; then
        print_success "AWS authentication valid"
        return 0
    else
        print_warning "AWS session expired or not authenticated"
        print_info "Running AWS SSO login..."
        aws sso login --profile "$AWS_PROFILE"

        # Verify login succeeded
        if aws sts get-caller-identity --profile "$AWS_PROFILE" &>/dev/null; then
            print_success "AWS authentication successful"
            return 0
        else
            print_error "AWS authentication failed"
            exit 1
        fi
    fi
}

# List available services
list_services() {
    print_info "Available services:"
    echo ""

    if [ ! -d "$SERVICES_DIR" ]; then
        print_warning "No services directory found at $SERVICES_DIR"
        exit 1
    fi

    for file in "$SERVICES_DIR"/*.md; do
        if [ -f "$file" ]; then
            service_name=$(basename "$file" .md)
            echo "  - $service_name"
        fi
    done
    echo ""
}

# Run analysis with Claude
run_analyze() {
    local service="$1"
    local timeframe="$2"
    local service_config="$SERVICES_DIR/$service.md"
    local analysis_output="$ANALYSIS_DIR/$service-analysis.md"
    local timeframe_minutes=$(parse_timeframe_to_minutes "$timeframe")

    # Check service config exists
    if [ ! -f "$service_config" ]; then
        print_error "Service config not found: $service_config"
        print_info "Available services:"
        list_services
        exit 1
    fi

    # Check AWS auth first
    check_aws_auth

    # Ensure analysis directory exists
    mkdir -p "$ANALYSIS_DIR"

    # Calculate time range
    local end_time=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    local start_time=$(date -u -v-${timeframe_minutes}M +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date -u -d "-${timeframe_minutes} minutes" +"%Y-%m-%dT%H:%M:%SZ")

    print_info "Starting SRE analysis for: $service"
    print_info "Timeframe: $timeframe (last $timeframe_minutes minutes)"
    print_info "Time range: $start_time to $end_time"
    print_info "Output will be saved to: $analysis_output"
    echo ""

    # Build the prompt for Claude
    local prompt=$(cat << EOF
You are an SRE agent helping debug and analyze a production service incident.

SERVICE: $service
TIMEFRAME: Last $timeframe ($timeframe_minutes minutes)
TIME RANGE: $start_time to $end_time
AWS PROFILE: $AWS_PROFILE

YOUR TASK:
1. Read the service configuration below to understand the architecture, log groups, metrics, and health checks
2. Run the AWS CLI commands to gather logs and metrics for the specified timeframe
3. Check the health endpoints
4. Analyze all the data to identify issues, anomalies, or root causes
5. Generate a comprehensive RCA (Root Cause Analysis) report

IMPORTANT INSTRUCTIONS:
- Use the AWS CLI commands from the service config with --profile $AWS_PROFILE
- Adjust time ranges in queries to match the timeframe: $start_time to $end_time
- Run health checks and document their status
- Look for errors, exceptions, latency spikes, and anomalies
- Be thorough - this is an incident response situation

OUTPUT FORMAT:
Save your analysis to: $analysis_output

Use this template for the report:

# SRE Analysis Report: $service
**Generated:** $(date)
**Timeframe:** $timeframe (${start_time} to ${end_time})
**Analyst:** Claude SRE Agent

## Executive Summary
[2-3 sentence summary of findings]

## Service Status
- **Overall Health:** [HEALTHY/DEGRADED/DOWN]
- **Health Check Results:** [Summary of health check results]

## Incident Timeline
[If applicable, timeline of events]

## Metrics Analysis
[Key metrics findings with specific values]

## Log Analysis
[Key log findings, error patterns, stack traces]

## Root Cause Analysis
[Identified or suspected root cause]

## Impact Assessment
[What was affected, for how long, how many users/requests]

## Recommendations
1. [Immediate actions]
2. [Short-term fixes]
3. [Long-term improvements]

## Commands Executed
[List of commands run during analysis]

---
*Report generated by SRE Agent*

---

SERVICE CONFIGURATION:
$(cat "$service_config")
EOF
)

    # Get Claude path from NVM
    local nvm_dir="$HOME/.nvm"
    local node_version=$(source "$nvm_dir/nvm.sh" && nvm current 2>/dev/null | tr -d '[:space:]')
    local claude_path="$nvm_dir/versions/node/$node_version/bin/claude"

    # Use claude from path if NVM path doesn't exist
    if [ ! -f "$claude_path" ]; then
        claude_path="claude"
    fi

    # Run Claude with the prompt (no --continue, fresh session)
    echo "$prompt" | "$claude_path" --print

    print_success "Analysis complete!"
    print_info "View the report with: sre --analysis --service $service"
}

# View existing analysis
view_analysis() {
    local service="$1"
    local analysis_file="$ANALYSIS_DIR/$service-analysis.md"

    if [ ! -f "$analysis_file" ]; then
        print_error "No analysis found for service: $service"
        print_info "Run: sre --analyze --service $service"
        exit 1
    fi

    # Use bat if available, otherwise cat
    if command -v bat &>/dev/null; then
        bat --style=full --paging=always "$analysis_file"
    else
        cat "$analysis_file"
    fi
}

# Parse arguments
ACTION=""
SERVICE=""
TIMEFRAME="$DEFAULT_TIMEFRAME"

while [[ $# -gt 0 ]]; do
    case $1 in
        --analyze)
            ACTION="analyze"
            shift
            ;;
        --analysis)
            ACTION="analysis"
            shift
            ;;
        --list)
            ACTION="list"
            shift
            ;;
        --service|-s)
            SERVICE="$2"
            shift 2
            ;;
        --timeframe|-t)
            TIMEFRAME="$2"
            shift 2
            ;;
        --help|-h)
            usage
            ;;
        *)
            print_error "Unknown option: $1"
            usage
            ;;
    esac
done

# Validate and execute
case "$ACTION" in
    analyze)
        if [ -z "$SERVICE" ]; then
            print_error "Service is required for --analyze"
            usage
        fi
        run_analyze "$SERVICE" "$TIMEFRAME"
        ;;
    analysis)
        if [ -z "$SERVICE" ]; then
            print_error "Service is required for --analysis"
            usage
        fi
        view_analysis "$SERVICE"
        ;;
    list)
        list_services
        ;;
    *)
        print_error "No action specified"
        usage
        ;;
esac
