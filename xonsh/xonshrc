"""
~/.xonshrc — clean xonsh setup

No dotfiles port. Just:
- A solid Python library bundle pre-imported on demand
- xontribs for completion, fuzzy finding, prompt, command durations
- AI helpers backed by the local `claude` CLI
- A small set of universal aliases (no nvim-launcher / k8s / terraform stuff)
"""

import os
import subprocess
from pathlib import Path

# ----------------------------------------------------------------------------
# PATHS — Homebrew + common bin locations
# ----------------------------------------------------------------------------
HOMEBREW_PREFIX = '/opt/homebrew' if Path('/opt/homebrew/bin/brew').exists() else '/usr/local'
$HOMEBREW_PREFIX = HOMEBREW_PREFIX

for _p in [
    f'{HOMEBREW_PREFIX}/bin',
    f'{HOMEBREW_PREFIX}/sbin',
    f'{os.path.expanduser("~")}/.cargo/bin',
    f'{os.path.expanduser("~")}/.local/bin',
]:
    if Path(_p).is_dir() and _p not in $PATH:
        $PATH.insert(0, _p)

# ----------------------------------------------------------------------------
# QUALITY-OF-LIFE SETTINGS
# ----------------------------------------------------------------------------
$TERM = 'xterm-256color'
$XONSH_SHOW_TRACEBACK = True            # surface python tracebacks
$XONSH_AUTOPAIR = True                  # auto-close brackets/quotes
$AUTO_CD = True                         # `mydir` cds into mydir
$COMPLETIONS_CONFIRM = True             # one enter after completion
$XONSH_HISTORY_SIZE = (10000, 'commands')
$UPDATE_OS_ENVIRON = True               # keep os.environ in sync with $
$MULTILINE_PROMPT = '.'
$XONSH_AUTOPAIR = True

# ----------------------------------------------------------------------------
# XONTRIBS — completion, fuzzy finding, prompt, command timing
# ----------------------------------------------------------------------------
$fzf_history_binding = "c-r"
$fzf_ssh_binding = "c-s"
$fzf_file_binding = "c-t"
$fzf_dir_binding = "c-g"

def _try_xontrib(name):
    try:
        __xonsh__.execer.exec(f'xontrib load {name}', glbs=globals())
    except Exception as _e:
        print(f'(skipped xontrib {name}: {_e})')

for _x in ['jedi', 'abbrevs', 'cmd_done', 'readable-traceback',
           'argcomplete', 'zoxide', 'fzf-widgets']:
    _try_xontrib(_x)

# ----------------------------------------------------------------------------
# ALIASES — universal, non-tool-specific
# ----------------------------------------------------------------------------

# nicer defaults for ls / cat (only if the tools exist)
if Path(f'{HOMEBREW_PREFIX}/bin/bat').exists():
    aliases['cat'] = 'bat --paging=never'
if Path(f'{HOMEBREW_PREFIX}/bin/eza').exists():
