    aliases['ll'] = 'eza --icons --git --group-directories-first --long --all'
    aliases['lst'] = 'eza --icons --git --group-directories-first --tree --level=2 --all'

# directory navigation
aliases['..'] = 'cd ..'
aliases['...'] = 'cd ../..'
aliases['....'] = 'cd ../../..'
aliases['home'] = 'cd ~'

# git basics
aliases['g'] = 'git'
aliases['gs'] = 'git status'
aliases['ga'] = 'git add'
aliases['gc'] = 'git commit -m'
aliases['gd'] = 'git diff'
aliases['gl'] = 'git log --oneline -20'
aliases['gco'] = 'git checkout'
aliases['gb'] = 'git branch'
aliases['gf'] = 'git fetch'

# python shortcuts
aliases['py'] = 'python3'
aliases['py3'] = 'python3'
aliases['ipy'] = 'ipython'

# ----------------------------------------------------------------------------
# ABBREVIATIONS — expand inline as you type a space after them
# (provided by xontrib-abbrevs)
# ----------------------------------------------------------------------------
abbrevs['gst'] = 'git status'
abbrevs['gcb'] = 'git checkout -b'
abbrevs['gdc'] = 'git diff --cached'
abbrevs['gpsh'] = 'git push'
abbrevs['gpll'] = 'git pull'
abbrevs['glog'] = 'git log --oneline --graph --all -30'

# ----------------------------------------------------------------------------
# AI HELPERS — wrap the local `claude` CLI for inline AI in the shell
# ----------------------------------------------------------------------------

def _ai_ask(args):
    """`ai <prompt>` — ask Claude a question, get a plain answer."""
    if not args:
        print("usage: ai <prompt>")
        return
    subprocess.run(['claude', '-p', ' '.join(args)])
aliases['ai'] = _ai_ask

def _ai_cmd(args):
    """`?? <description>` — Claude suggests a shell command, then offers to run it."""
    if not args:
        print("usage: ?? <what you want to do>")
        return
    desc = ' '.join(args)
    sys_prompt = (
        "You are a shell command generator. Output ONLY a single shell command "
        "that accomplishes what the user asks. No explanation, no markdown fences, "
        "no quotes around the whole command. Just the command."
    )
    r = subprocess.run(
        ['claude', '-p', f'{sys_prompt}\n\nUser request: {desc}'],
        capture_output=True, text=True
    )
    cmd = r.stdout.strip().strip('`').strip()
    if not cmd:
        print(f"(no command returned)\n{r.stderr}")
        return
    print(f"\n  $ {cmd}\n")
    try:
        confirm = input("run? [y/N] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        return
    if confirm == 'y':
        subprocess.run(cmd, shell=True)
aliases['??'] = _ai_cmd

def _ai_explain(args):
    """`explain <command>` — Claude explains what a shell command does."""
    if not args:
        print("usage: explain <command>")
        return
    subprocess.run(['claude', '-p', f'Explain concisely what this shell command does: {" ".join(args)}'])
aliases['explain'] = _ai_explain

# ----------------------------------------------------------------------------
# PYTHON LIB QUICK-IMPORT — `pyimport` populates the namespace with common libs
# Saves typing `import pandas as pd; import requests; ...` every time.
# ----------------------------------------------------------------------------

def _pyimport(args):
    """Pre-import the common data + web libs into the xonsh Python namespace."""
    import importlib
    mapping = {
        'pd': 'pandas', 'np': 'numpy', 'pl': 'polars', 'duckdb': 'duckdb',
        'requests': 'requests', 'httpx': 'httpx', 'bs4': 'bs4',
        'rich': 'rich', 'typer': 'typer',
        'openpyxl': 'openpyxl', 'yaml': 'yaml', 'json': 'json',
        'Path': 'pathlib:Path', 're': 're', 'os': 'os', 'sys': 'sys',
    }
    loaded, failed = [], []
    for alias_name, modspec in mapping.items():
        try:
            if ':' in modspec:
                mod_name, attr = modspec.split(':')
                __xonsh__.ctx[alias_name] = getattr(importlib.import_module(mod_name), attr)
            else:
                __xonsh__.ctx[alias_name] = importlib.import_module(modspec)
            loaded.append(alias_name)
        except ImportError:
            failed.append(alias_name)
    print(f"loaded: {', '.join(loaded)}")
    if failed:
        print(f"missing: {', '.join(failed)}")
aliases['pyimport'] = _pyimport

