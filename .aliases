# directories (enhanced with zoxide smart jumping)
alias home='cd ~'
alias ..='cd ..'
alias ...='cd ../..'
alias back='cd -'
alias root='cd /'
alias notif="printf ''"

# zoxide shortcuts
alias zi='zi'
alias za='zoxide add'
alias zq='zoxide query'
alias zr='zoxide remove'

# ls
alias lst='eza --icons --git --color=always --group-directories-first --tree --level=2 --no-permissions --no-user --no-time --all'

# read files
alias cat='bat --paging=never'

# git
alias ga='git add'
alias gc='git commit -m'
alias gf='git fetch'
alias gs='git status'
alias gpsh='git push'
alias gpll='git pull'
alias grt='cd $(git rev-parse --show-toplevel 2>/dev/null || echo ".")'
alias grv='gh run view'
# grw is now a function in scripts/shell/git/functions.sh (with notification support)
alias gtl="git tag --sort=-v:refname | head -n 1"

# lazy
alias lg='lazygit'
alias ld='lazydocker'
alias sql='lazysql'

# kubernets
alias k="kubectl"
alias ka="kubectl apply -f . -R"
alias kctx="kubectx"
alias kns="kubens"

# terraform
alias tf="terraform"
alias tfa="terraform apply"
alias tfi="terraform init"
alias tfd="terraform destroy"
alias tfp="terraform plan"
alias tfs="terraform show"
alias tfv="terraform validate"
alias tfc="terraform console"

# terragrunt
alias tg="terragrunt"
alias tga="terragrunt apply"
alias tgi="terragrunt init"
alias tgd="terragrunt destroy"
alias tgp="terragrunt plan"
alias tgs="terragrunt show"
alias tgv="terragrunt validate"
alias tgc="terragrunt console"
alias tgf="terragrunt hcl format"

# task warrior
alias tka="task add"
alias tk="task"
alias tkl="task list"
alias tkc="task completed"
alias tkd="task deleted"

# system control
alias slp="pmset sleepnow"
alias bt="bluetooth-tui"

# azure
alias a="az"
alias azs="azure-searcher"
alias azi="az interactive"

# aws
alias aap="aws-auto-prompt"

# spotify
alias spl='spotify play'
alias spa='spotify pause'
alias sn='spotify next'
alias sp='spotify prev'
alias ss='spotify status'
alias svu='spotify vol up'
alias svd='spotify vol down'

# api
alias curlj='curl_with_jqp'
alias curlv='curl_with_wireshark'

# python
alias py='python'
alias py3='python3'
