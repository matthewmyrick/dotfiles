#!/bin/bash

# Simple, clear sketchybar configuration

# Bar appearance
sketchybar --bar height=32 \
                 blur_radius=30 \
                 position=top \
                 sticky=on \
                 padding_left=10 \
                 padding_right=10 \
                 color=0x00000000

# Default values for all items
default=(
  icon.font="SF Pro:Semibold:15.0"
  icon.color=0xff000000
  label.font="SF Pro:Regular:15.0"
  label.color=0xff000000
  padding_left=5
  padding_right=5
  label.padding_left=4
  label.padding_right=4
  icon.padding_left=4
  icon.padding_right=4
)

sketchybar --default "${default[@]}"

# -- Left Side Items --

# App Icon (emoji based on active app)
sketchybar --add item app_icon left \
           --set app_icon update_freq=1 \
                       script='
APP_NAME=$(osascript -e "tell application \"System Events\" to get name of first application process whose frontmost is true")
APP_NAME_UPPER=$(echo "$APP_NAME" | tr "[:lower:]" "[:upper:]")
if [[ "$APP_NAME_UPPER" == *"GHOSTTY"* ]]; then EMOJI="👻"
elif [[ "$APP_NAME_UPPER" == *"TERMINAL"* ]]; then EMOJI="💻"
elif [[ "$APP_NAME_UPPER" == *"CHROME"* ]]; then EMOJI="🌐"
elif [[ "$APP_NAME_UPPER" == *"SAFARI"* ]]; then EMOJI="🧭"
elif [[ "$APP_NAME_UPPER" == *"FINDER"* ]]; then EMOJI="📁"
elif [[ "$APP_NAME_UPPER" == *"SPOTIFY"* ]]; then EMOJI="🎵"
elif [[ "$APP_NAME_UPPER" == *"SLACK"* ]]; then EMOJI="💬"
elif [[ "$APP_NAME_UPPER" == *"DISCORD"* ]]; then EMOJI="🎮"
elif [[ "$APP_NAME_UPPER" == *"TEAMS"* ]]; then EMOJI="🤝"
elif [[ "$APP_NAME_UPPER" == *"CODE"* ]]; then EMOJI="📝"
elif [[ "$APP_NAME_UPPER" == *"MESSAGES"* ]]; then EMOJI="💬"
elif [[ "$APP_NAME_UPPER" == *"MAIL"* ]]; then EMOJI="📧"
elif [[ "$APP_NAME_UPPER" == *"CALENDAR"* ]]; then EMOJI="📅"
elif [[ "$APP_NAME_UPPER" == *"NOTES"* ]]; then EMOJI="📓"
elif [[ "$APP_NAME_UPPER" == *"PREVIEW"* ]]; then EMOJI="🖼️"
elif [[ "$APP_NAME_UPPER" == *"SYSTEM PREFERENCES"* ]]; then EMOJI="⚙️"
elif [[ "$APP_NAME_UPPER" == *"SYSTEM SETTINGS"* ]]; then EMOJI="⚙️"
else EMOJI="🤷"
fi
sketchybar --set app_icon label="$EMOJI"
' \
                       icon.drawing=off \
                       label.font="SF Pro:Regular:20.0" \
                       padding_right=5

# Front App (Active Application)  
sketchybar --add item front_app left \
           --set front_app update_freq=1 \
                       script='APP_NAME=$(osascript -e "tell application \"System Events\" to get name of first application process whose frontmost is true"); APP_UPPER=$(echo "$APP_NAME" | tr "[:lower:]" "[:upper:]"); sketchybar --set front_app label="$APP_UPPER"' \
                       icon.drawing=off \
                       padding_left=5

# CPU Usage
sketchybar --add item cpu left \
           --set cpu update_freq=2 \
                    icon="CPU" \
                    icon.font="SF Pro:Regular:13.0" \
                    script='CPU=$(top -l 1 | grep "CPU usage" | awk "{print int(\$3)}"); sketchybar --set cpu label="${CPU}%"'

# Memory Usage  
sketchybar --add item memory left \
           --set memory update_freq=5 \
                        icon="MEM" \
                        icon.font="SF Pro:Regular:13.0" \
                        script='MEM=$(memory_pressure | grep "System-wide memory free percentage" | awk "{print 100-\$5}" | cut -d "%" -f1); sketchybar --set memory label="${MEM}%"'

# Network Activity (WiFi signal strength)
sketchybar --add item network left \
           --set network update_freq=5 \
                        icon="NET" \
                        icon.font="SF Pro:Regular:13.0" \
                        script='
WIFI_INFO=$(/System/Library/PrivateFrameworks/Apple80211.framework/Resources/airport -I 2>/dev/null)
if [[ -n "$WIFI_INFO" ]]; then
  RSSI=$(echo "$WIFI_INFO" | grep -E "agrCtlRSSI|RSSI" | awk "{print \$2}")
  if [[ -n "$RSSI" ]]; then
    # Convert RSSI to percentage (approximation)
    # -30 dBm = 100%, -90 dBm = 0%
    if [ $RSSI -ge -30 ]; then
      PERCENT=100
    elif [ $RSSI -le -90 ]; then
      PERCENT=0
    else
      PERCENT=$(( 100 - (($RSSI * -1 - 30) * 100 / 60) ))
    fi
    sketchybar --set network label="${PERCENT}%"
  else
    sketchybar --set network label="--"
  fi
else
  sketchybar --set network label="OFF"
fi
'

sketchybar --add event window_focus \
           --add event windows_on_spaces

# -- Right Side Items --

# Clock (12-hour format in EST)
sketchybar --add item clock right \
           --set clock update_freq=10 \
                      icon.drawing=off \
                      script="sketchybar --set clock label=\"\$(TZ='America/New_York' date '+%I:%M %p')\""

# Date (MM/DD/YYYY format)
sketchybar --add item date right \
           --set date update_freq=60 \
                     icon.drawing=off \
                     script="sketchybar --set date label=\"\$(date '+%m/%d/%Y')\""

# Battery
sketchybar --add item battery right \
           --set battery update_freq=10 \
                        script='
BATTERY_PERCENT=$(pmset -g batt | grep -o "[0-9]*%" | sed "s/%//")
BATTERY_STATUS=$(pmset -g batt | grep -o "charging\|discharging\|charged")

# Set battery icon based on percentage and charging status
if [[ "$BATTERY_STATUS" == "charging" ]]; then
  BATTERY_ICON="󰂄"  # Charging icon
elif [ $BATTERY_PERCENT -ge 90 ]; then
  BATTERY_ICON="󰁹"  # 100%
elif [ $BATTERY_PERCENT -ge 75 ]; then
  BATTERY_ICON="󰂂"  # 75%
elif [ $BATTERY_PERCENT -ge 50 ]; then
  BATTERY_ICON="󰂀"  # 50%
elif [ $BATTERY_PERCENT -ge 25 ]; then
  BATTERY_ICON="󰁾"  # 25%
elif [ $BATTERY_PERCENT -ge 10 ]; then
  BATTERY_ICON="󰁼"  # 10%
else
  BATTERY_ICON="󰁺"  # Very low
fi

# Low battery notification (15% and 5%) - only once per session
NOTIFICATION_FILE="/tmp/sketchybar_battery_notifications"

if [ $BATTERY_PERCENT -eq 15 ] && [[ "$BATTERY_STATUS" == "discharging" ]]; then
  if ! grep -q "15_notified" "$NOTIFICATION_FILE" 2>/dev/null; then
    osascript -e "display notification \"Battery at ${BATTERY_PERCENT}%\" with title \"Low Battery Warning\" sound name \"Basso\""
    echo "15_notified" >> "$NOTIFICATION_FILE"
  fi
elif [ $BATTERY_PERCENT -eq 5 ] && [[ "$BATTERY_STATUS" == "discharging" ]]; then
  if ! grep -q "5_notified" "$NOTIFICATION_FILE" 2>/dev/null; then
    osascript -e "display notification \"Battery critically low at ${BATTERY_PERCENT}%! Connect charger immediately.\" with title \"Critical Battery Warning\" sound name \"Sosumi\""
    echo "5_notified" >> "$NOTIFICATION_FILE"
  fi
fi

# Reset notification flags when charging or battery level increases
if [[ "$BATTERY_STATUS" == "charging" ]] || [ $BATTERY_PERCENT -gt 20 ]; then
  rm -f "$NOTIFICATION_FILE" 2>/dev/null
fi

sketchybar --set battery icon="$BATTERY_ICON" label="${BATTERY_PERCENT}%"
'

# WiFi Network
sketchybar --add item wifi right \
           --set wifi update_freq=5 \
                        icon=󰤨 \
                        icon.font="SF Pro:Regular:15.0" \
                        label.font="SF Pro:Regular:13.0" \
                        script='
# Use Python to get WiFi SSID reliably
SSID=$(python3 -c "
import subprocess
import re
try:
    # Get WiFi info from system_profiler
    result = subprocess.run([\"system_profiler\", \"SPAirPortDataType\"], capture_output=True, text=True)
    output = result.stdout
    
    # Find Current Network Information section
    current_section = output.split(\"Current Network Information:\")[1].split(\"Other Local Wi-Fi Networks:\")[0]
    
    # Extract network name (first line after Current Network Information that ends with colon)
    for line in current_section.split(\"\\n\"):
        line = line.strip()
        if line and line.endswith(\":\") and \"PHY\" not in line:
            ssid = line[:-1]  # Remove the colon
            print(ssid)
            break
except:
    pass
" 2>/dev/null)

if [[ -n "$SSID" ]]; then
  # Connected - show WiFi icon with network name
  sketchybar --set wifi icon=󰤨 label="$SSID"
else
  # Not connected - show WiFi with slash, no name
  sketchybar --set wifi icon=󰤭 label=""
fi
'

# VPN Status
sketchybar --add item vpn right \
           --set vpn update_freq=5 \
                      icon=󰒃 \
                      icon.font="SF Pro:Regular:15.0" \
                      label.font="SF Pro:Regular:13.0" \
                      script='
# Check for traditional VPNs
VPN_STATUS=$(scutil --nc list | grep "Connected" | head -1)
VPN_NAME=""

if [[ -n "$VPN_STATUS" ]]; then
  VPN_NAME=$(echo "$VPN_STATUS" | sed -E "s/.*\"(.+)\".*/\1/" | head -1)
fi

# Check for Netskope (treat as VPN)
NETSKOPE_RUNNING=$(ps aux | grep -i "netskope" | grep -v grep | head -1)
if [[ -n "$NETSKOPE_RUNNING" ]]; then
  if [[ -z "$VPN_NAME" ]]; then
    VPN_NAME="Netskope"
  else
    VPN_NAME="$VPN_NAME, Netskope"
  fi
fi

if [[ -n "$VPN_NAME" ]]; then
  # Truncate long VPN names
  if [ ${#VPN_NAME} -gt 12 ]; then
    VPN_NAME="${VPN_NAME:0:12}..."
  fi
  sketchybar --set vpn label="$VPN_NAME" drawing=on
else
  sketchybar --set vpn drawing=off
fi
'

# Bluetooth Device
sketchybar --add item bluetooth right \
           --set bluetooth update_freq=5 \
                        icon=󰂯 \
                        icon.font="SF Pro:Regular:15.0" \
                        label.font="SF Pro:Regular:13.0" \
                        script='
BT_DEVICES=$(blueutil --connected 2>/dev/null | grep -v "^\s*$")
if [[ -n "$BT_DEVICES" ]]; then
  # Get first connected device name
  BT_DEVICE=$(echo "$BT_DEVICES" | head -1 | cut -d "," -f2 | sed "s/name: //g" | xargs)
  if [[ -n "$BT_DEVICE" ]]; then
    # Truncate long device names
    if [ ${#BT_DEVICE} -gt 15 ]; then
      BT_DEVICE="${BT_DEVICE:0:15}..."
    fi
    sketchybar --set bluetooth label="$BT_DEVICE" drawing=on
  else
    sketchybar --set bluetooth drawing=off
  fi
else
  sketchybar --set bluetooth drawing=off
fi
'

# Spotify (next to volume)
sketchybar --add item spotify right \
           --set spotify update_freq=2 \
                        icon=🎵 \
                        icon.font="SF Pro:Regular:16.0" \
                        label.max_chars=25 \
                        label.font="SF Pro:Regular:13.0" \
                        script='
TRACK=$(osascript -e "tell application \"Spotify\" to if player state is playing then return name of current track" 2>/dev/null)
if [[ -n "$TRACK" ]]; then
  sketchybar --set spotify label="$TRACK" drawing=on
else
  sketchybar --set spotify drawing=off
fi
'

# Volume
sketchybar --add item volume right \
           --set volume update_freq=1 \
                       script="sketchybar --set volume label=\"\$(osascript -e 'output volume of (get volume settings)')%\"" \
                       icon=󰕾

# Subscribe to events
sketchybar --subscribe front_app window_focus windows_on_spaces

# Force update all items on start
sketchybar --update

# Trigger initial front_app update
sketchybar --trigger window_focus

echo "sketchybar configuration loaded"