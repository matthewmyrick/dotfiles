#!/bin/bash

# Simple, clear sketchybar configuration

# Bar appearance
sketchybar --bar height=32 \
                 blur_radius=30 \
                 position=top \
                 sticky=on \
                 padding_left=10 \
                 padding_right=10 \
                 color=0x00000000

# Default values for all items
default=(
  icon.font="SF Pro:Semibold:15.0"
  icon.color=0xff000000
  label.font="SF Pro:Regular:15.0"
  label.color=0xff000000
  padding_left=5
  padding_right=5
  label.padding_left=4
  label.padding_right=4
  icon.padding_left=4
  icon.padding_right=4
)

sketchybar --default "${default[@]}"

# -- Left Side Items --

# App Icon (emoji based on active app)
sketchybar --add item app_icon left \
           --set app_icon update_freq=1 \
                       script='
APP_NAME=$(osascript -e "tell application \"System Events\" to get name of first application process whose frontmost is true")
APP_NAME_UPPER=$(echo "$APP_NAME" | tr "[:lower:]" "[:upper:]")
if [[ "$APP_NAME_UPPER" == *"GHOSTTY"* ]]; then EMOJI="👻"
elif [[ "$APP_NAME_UPPER" == *"TERMINAL"* ]]; then EMOJI="💻"
elif [[ "$APP_NAME_UPPER" == *"CHROME"* ]]; then EMOJI="🌐"
elif [[ "$APP_NAME_UPPER" == *"SAFARI"* ]]; then EMOJI="🧭"
elif [[ "$APP_NAME_UPPER" == *"FINDER"* ]]; then EMOJI="📁"
elif [[ "$APP_NAME_UPPER" == *"SPOTIFY"* ]]; then EMOJI="🎵"
elif [[ "$APP_NAME_UPPER" == *"SLACK"* ]]; then EMOJI="💬"
elif [[ "$APP_NAME_UPPER" == *"DISCORD"* ]]; then EMOJI="🎮"
elif [[ "$APP_NAME_UPPER" == *"TEAMS"* ]]; then EMOJI="🤝"
elif [[ "$APP_NAME_UPPER" == *"CODE"* ]]; then EMOJI="📝"
elif [[ "$APP_NAME_UPPER" == *"MESSAGES"* ]]; then EMOJI="💬"
elif [[ "$APP_NAME_UPPER" == *"MAIL"* ]]; then EMOJI="📧"
elif [[ "$APP_NAME_UPPER" == *"CALENDAR"* ]]; then EMOJI="📅"
elif [[ "$APP_NAME_UPPER" == *"NOTES"* ]]; then EMOJI="📓"
elif [[ "$APP_NAME_UPPER" == *"PREVIEW"* ]]; then EMOJI="🖼️"
elif [[ "$APP_NAME_UPPER" == *"SYSTEM PREFERENCES"* ]]; then EMOJI="⚙️"
elif [[ "$APP_NAME_UPPER" == *"SYSTEM SETTINGS"* ]]; then EMOJI="⚙️"
else EMOJI="🤷"
fi
sketchybar --set app_icon label="$EMOJI"
' \
                       icon.drawing=off \
                       label.font="SF Pro:Regular:20.0" \
                       padding_right=5

# Front App (Active Application)  
sketchybar --add item front_app left \
           --set front_app update_freq=1 \
                       script='APP_NAME=$(osascript -e "tell application \"System Events\" to get name of first application process whose frontmost is true"); APP_UPPER=$(echo "$APP_NAME" | tr "[:lower:]" "[:upper:]"); sketchybar --set front_app label="$APP_UPPER"' \
                       icon.drawing=off \
                       padding_left=5

# CPU Usage
sketchybar --add item cpu left \
           --set cpu update_freq=2 \
                    icon="CPU" \
                    icon.font="SF Pro:Regular:13.0" \
                    script='
CPU=$(top -l 1 | grep "CPU usage" | awk "{print int(\$3)}")
PREV_CPU=$(cat /tmp/sketchybar_cpu_prev 2>/dev/null || echo "$CPU")
COLOR_FILE="/tmp/sketchybar_cpu_color"
COLOR_COUNTER=$(cat "$COLOR_FILE" 2>/dev/null || echo "0")

# Check if CPU changed
if [ $CPU -gt $PREV_CPU ]; then
  # CPU increased - soft red
  COLOR="0xff990000"
  echo "3" > "$COLOR_FILE"  # Show color for 3 updates (6 seconds)
elif [ $CPU -lt $PREV_CPU ]; then
  # CPU decreased - dark green
  COLOR="0xff004400"
  echo "3" > "$COLOR_FILE"
elif [ $COLOR_COUNTER -gt 0 ]; then
  # Continue showing previous color
  if [ $CPU -gt $PREV_CPU ]; then
    COLOR="0xff990000"
  else
    COLOR="0xff004400"
  fi
  echo $(( $COLOR_COUNTER - 1 )) > "$COLOR_FILE"
else
  # No change, default color (black)
  COLOR="0xff000000"
fi

echo "$CPU" > /tmp/sketchybar_cpu_prev
sketchybar --set cpu label="${CPU}%" label.color="$COLOR" icon.color="$COLOR"
'

# Memory Usage
sketchybar --add item memory left \
           --set memory update_freq=5 \
                        icon="MEM" \
                        icon.font="SF Pro:Regular:13.0" \
                        script='
MEM=$(memory_pressure | grep "System-wide memory free percentage" | awk "{print 100-\$5}" | cut -d "%" -f1)
PREV_MEM=$(cat /tmp/sketchybar_mem_prev 2>/dev/null || echo "$MEM")
COLOR_FILE="/tmp/sketchybar_mem_color"
COLOR_COUNTER=$(cat "$COLOR_FILE" 2>/dev/null || echo "0")

# Check if Memory changed
if [ $MEM -gt $PREV_MEM ]; then
  # Memory usage increased - soft red
  COLOR="0xff990000"
  echo "3" > "$COLOR_FILE"  # Show color for 3 updates (15 seconds at 5s interval)
elif [ $MEM -lt $PREV_MEM ]; then
  # Memory usage decreased - dark green
  COLOR="0xff004400"
  echo "3" > "$COLOR_FILE"
elif [ $COLOR_COUNTER -gt 0 ]; then
  # Continue showing previous color
  LAST_COLOR=$(cat /tmp/sketchybar_mem_last_color 2>/dev/null || echo "white")
  if [ "$LAST_COLOR" = "red" ]; then
    COLOR="0xff990000"
  else
    COLOR="0xff004400"
  fi
  echo $(( $COLOR_COUNTER - 1 )) > "$COLOR_FILE"
else
  # No change, default color (black)
  COLOR="0xff000000"
fi

# Save state for next update
echo "$MEM" > /tmp/sketchybar_mem_prev
if [ $MEM -gt $PREV_MEM ]; then
  echo "red" > /tmp/sketchybar_mem_last_color
elif [ $MEM -lt $PREV_MEM ]; then
  echo "green" > /tmp/sketchybar_mem_last_color
fi

sketchybar --set memory label="${MEM}%" label.color="$COLOR" icon.color="$COLOR"
'

# Network Usage
sketchybar --add item network left \
           --set network update_freq=2 \
                        icon="NET" \
                        icon.font="SF Pro:Regular:13.0" \
                        script='
# Get network interface stats (only en interfaces with Link#)
NET_STATS=$(netstat -ibn | awk "/^en.*Link/ {ibytes+=\$7; obytes+=\$10} END {print ibytes, obytes}")
IBYTES=$(echo $NET_STATS | awk "{print \$1}")
OBYTES=$(echo $NET_STATS | awk "{print \$2}")

# Read previous values
PREV_IBYTES=$(cat /tmp/sketchybar_net_ibytes 2>/dev/null || echo "$IBYTES")
PREV_OBYTES=$(cat /tmp/sketchybar_net_obytes 2>/dev/null || echo "$OBYTES")
PREV_TIME=$(cat /tmp/sketchybar_net_time 2>/dev/null || echo "$(date +%s)")
CURRENT_TIME=$(date +%s)

# Calculate bytes per second
TIME_DIFF=$((CURRENT_TIME - PREV_TIME))
if [ $TIME_DIFF -gt 0 ]; then
  IBYTES_DIFF=$((IBYTES - PREV_IBYTES))
  OBYTES_DIFF=$((OBYTES - PREV_OBYTES))

  # Convert to Mbps
  DOWN_MBPS=$(echo "scale=1; ($IBYTES_DIFF * 8) / ($TIME_DIFF * 1000000)" | bc)
  UP_MBPS=$(echo "scale=1; ($OBYTES_DIFF * 8) / ($TIME_DIFF * 1000000)" | bc)

  # Assume 1 Gbps max capacity (adjust if your connection is different)
  MAX_MBPS=1000
  TOTAL_MBPS=$(echo "$DOWN_MBPS + $UP_MBPS" | bc)
  NET_PERCENT=$(echo "scale=0; ($TOTAL_MBPS * 100) / $MAX_MBPS" | bc 2>/dev/null || echo "0")

  # Cap at 100%
  if [ $NET_PERCENT -gt 100 ]; then
    NET_PERCENT=100
  fi
else
  NET_PERCENT=0
fi

# Color change based on usage change
PREV_NET=$(cat /tmp/sketchybar_net_prev 2>/dev/null || echo "$NET_PERCENT")
COLOR_FILE="/tmp/sketchybar_net_color"
COLOR_COUNTER=$(cat "$COLOR_FILE" 2>/dev/null || echo "0")

if [ $NET_PERCENT -gt $PREV_NET ]; then
  # Network usage increased - soft red
  COLOR="0xff990000"
  echo "3" > "$COLOR_FILE"
elif [ $NET_PERCENT -lt $PREV_NET ]; then
  # Network usage decreased - dark green
  COLOR="0xff004400"
  echo "3" > "$COLOR_FILE"
elif [ $COLOR_COUNTER -gt 0 ]; then
  # Continue showing previous color
  LAST_COLOR=$(cat /tmp/sketchybar_net_last_color 2>/dev/null || echo "white")
  if [ "$LAST_COLOR" = "red" ]; then
    COLOR="0xff990000"
  else
    COLOR="0xff004400"
  fi
  echo $(( $COLOR_COUNTER - 1 )) > "$COLOR_FILE"
else
  COLOR="0xff000000"
fi

# Save state for next update
echo "$IBYTES" > /tmp/sketchybar_net_ibytes
echo "$OBYTES" > /tmp/sketchybar_net_obytes
echo "$CURRENT_TIME" > /tmp/sketchybar_net_time
echo "$NET_PERCENT" > /tmp/sketchybar_net_prev
if [ $NET_PERCENT -gt $PREV_NET ]; then
  echo "red" > /tmp/sketchybar_net_last_color
elif [ $NET_PERCENT -lt $PREV_NET ]; then
  echo "green" > /tmp/sketchybar_net_last_color
fi

sketchybar --set network label="${NET_PERCENT}%" label.color="$COLOR" icon.color="$COLOR"
'


# Disk Usage (SSD)
sketchybar --add item disk left \
           --set disk update_freq=600 \
                     icon="SSD" \
                     icon.font="SF Pro:Regular:13.0" \
                     script='
DISK_PERCENT=$(df -h /System/Volumes/Data | awk "NR==2 {print \$5}" | tr -d "%")

if [ $DISK_PERCENT -ge 90 ]; then
  COLOR="0xffcc0000"  # Red: critical
elif [ $DISK_PERCENT -ge 75 ]; then
  COLOR="0xffcc6600"  # Orange: warning
else
  COLOR="0xff000000"  # Black: normal
fi

sketchybar --set disk label="${DISK_PERCENT}%" label.color="$COLOR" icon.color="$COLOR"
'

# Spotify (rightmost item on the left side)
sketchybar --add item spotify left \
           --set spotify update_freq=2 \
                        icon=🎵 \
                        icon.font="SF Pro:Regular:16.0" \
                        label.font="SF Pro:Regular:13.0" \
                        label.max_chars=50 \
                        script='
TRACK=$(osascript -e "tell application \"Spotify\" to if player state is playing then return name of current track" 2>/dev/null)
if [[ -n "$TRACK" ]]; then
  # Show full track name (up to 50 chars max)
  sketchybar --set spotify label="$TRACK" drawing=on
else
  sketchybar --set spotify drawing=off
fi
'

sketchybar --add event window_focus \
           --add event windows_on_spaces

# -- Right Side Items --

# Clock (12-hour format in EST)
sketchybar --add item clock right \
           --set clock update_freq=10 \
                      icon.drawing=off \
                      script="sketchybar --set clock label=\"\$(TZ='America/New_York' date '+%I:%M %p')\""

# Date (MM/DD/YYYY format)
sketchybar --add item date right \
           --set date update_freq=60 \
                     icon.drawing=off \
                     script="sketchybar --set date label=\"\$(date '+%m/%d/%Y')\""

# Battery
sketchybar --add item battery right \
           --set battery update_freq=10 \
                        script='
BATTERY_PERCENT=$(pmset -g batt | grep -o "[0-9]*%" | sed "s/%//")
BATTERY_STATUS=$(pmset -g batt | grep -o "charging\|discharging\|charged")

# Set battery icon based on percentage and charging status
if [[ "$BATTERY_STATUS" == "charging" ]]; then
  BATTERY_ICON="󰂄"  # Charging icon
elif [ $BATTERY_PERCENT -ge 90 ]; then
  BATTERY_ICON="󰁹"  # 100%
elif [ $BATTERY_PERCENT -ge 75 ]; then
  BATTERY_ICON="󰂂"  # 75%
elif [ $BATTERY_PERCENT -ge 50 ]; then
  BATTERY_ICON="󰂀"  # 50%
elif [ $BATTERY_PERCENT -ge 25 ]; then
  BATTERY_ICON="󰁾"  # 25%
elif [ $BATTERY_PERCENT -ge 10 ]; then
  BATTERY_ICON="󰁼"  # 10%
else
  BATTERY_ICON="󰁺"  # Very low
fi

# Low battery notification (15% and 5%) - only once per session
NOTIFICATION_FILE="/tmp/sketchybar_battery_notifications"

if [ $BATTERY_PERCENT -eq 15 ] && [[ "$BATTERY_STATUS" == "discharging" ]]; then
  if ! grep -q "15_notified" "$NOTIFICATION_FILE" 2>/dev/null; then
    osascript -e "display notification \"Battery at ${BATTERY_PERCENT}%\" with title \"Low Battery Warning\" sound name \"Basso\""
    echo "15_notified" >> "$NOTIFICATION_FILE"
  fi
elif [ $BATTERY_PERCENT -eq 5 ] && [[ "$BATTERY_STATUS" == "discharging" ]]; then
  if ! grep -q "5_notified" "$NOTIFICATION_FILE" 2>/dev/null; then
    osascript -e "display notification \"Battery critically low at ${BATTERY_PERCENT}%! Connect charger immediately.\" with title \"Critical Battery Warning\" sound name \"Sosumi\""
    echo "5_notified" >> "$NOTIFICATION_FILE"
  fi
fi

# Reset notification flags when charging or battery level increases
if [[ "$BATTERY_STATUS" == "charging" ]] || [ $BATTERY_PERCENT -gt 20 ]; then
  rm -f "$NOTIFICATION_FILE" 2>/dev/null
fi

# Set color based on battery status and percentage
if [[ "$BATTERY_STATUS" == "charging" ]]; then
  COLOR="0xff004400"  # Dark green when charging
elif [ $BATTERY_PERCENT -ge 50 ]; then
  COLOR="0xff000000"  # Black for good battery
elif [ $BATTERY_PERCENT -ge 20 ]; then
  COLOR="0xffffff00"  # Yellow for medium battery
else
  COLOR="0xffff0000"  # Red for low battery
fi

sketchybar --set battery icon="$BATTERY_ICON" label="${BATTERY_PERCENT}%" label.color="$COLOR" icon.color="$COLOR"
'

# Volume (moved to left of battery)
sketchybar --add item volume right \
           --set volume update_freq=1 \
                       script="sketchybar --set volume label=\"\$(osascript -e 'output volume of (get volume settings)')%\"" \
                       icon=󰕾

# WiFi Network
sketchybar --add item wifi right \
           --set wifi update_freq=5 \
                        icon=󰤨 \
                        icon.font="SF Pro:Regular:15.0" \
                        label.font="SF Pro:Regular:13.0" \
                        script='
# Use Python to get WiFi SSID reliably
SSID=$(python3 -c "
import subprocess
import re
try:
    # Get WiFi info from system_profiler
    result = subprocess.run([\"system_profiler\", \"SPAirPortDataType\"], capture_output=True, text=True)
    output = result.stdout
    
    # Find Current Network Information section
    current_section = output.split(\"Current Network Information:\")[1].split(\"Other Local Wi-Fi Networks:\")[0]
    
    # Extract network name (first line after Current Network Information that ends with colon)
    for line in current_section.split(\"\\n\"):
        line = line.strip()
        if line and line.endswith(\":\") and \"PHY\" not in line:
            ssid = line[:-1]  # Remove the colon
            print(ssid)
            break
except:
    pass
" 2>/dev/null)

if [[ -n "$SSID" ]]; then
  # Truncate to 8 characters with dots
  if [ ${#SSID} -gt 8 ]; then
    SSID="${SSID:0:8}.."
  fi
  sketchybar --set wifi icon=󰤨 label="$SSID"
else
  sketchybar --set wifi icon=󰤭 label=""
fi
'

# VPN Status
sketchybar --add item vpn right \
           --set vpn update_freq=5 \
                      icon=󰒃 \
                      icon.font="SF Pro:Regular:15.0" \
                      label.font="SF Pro:Regular:13.0" \
                      script='
# Check for traditional VPNs
VPN_STATUS=$(scutil --nc list | grep "Connected" | head -1)
VPN_NAME=""

if [[ -n "$VPN_STATUS" ]]; then
  VPN_NAME=$(echo "$VPN_STATUS" | sed -E "s/.*\"(.+)\".*/\1/" | head -1)
fi

# Check for Netskope (treat as VPN)
NETSKOPE_RUNNING=$(ps aux | grep -i "netskope" | grep -v grep | head -1)
if [[ -n "$NETSKOPE_RUNNING" ]]; then
  if [[ -z "$VPN_NAME" ]]; then
    VPN_NAME="Netskope"
  else
    VPN_NAME="$VPN_NAME, Netskope"
  fi
fi

if [[ -n "$VPN_NAME" ]]; then
  # Truncate to 8 characters with dots
  if [ ${#VPN_NAME} -gt 8 ]; then
    VPN_NAME="${VPN_NAME:0:8}.."
  fi
  sketchybar --set vpn label="$VPN_NAME" drawing=on
else
  sketchybar --set vpn drawing=off
fi
'

# Bluetooth Device
sketchybar --add item bluetooth right \
           --set bluetooth update_freq=5 \
                        icon=󰂯 \
                        icon.font="SF Pro:Regular:15.0" \
                        label.font="SF Pro:Regular:13.0" \
                        script='
BT_DEVICES=$(blueutil --connected 2>/dev/null | grep -v "^\s*$")
if [[ -n "$BT_DEVICES" ]]; then
  # Get first connected device name
  BT_DEVICE=$(echo "$BT_DEVICES" | head -1 | cut -d "," -f2 | sed "s/name: //g" | xargs)
  if [[ -n "$BT_DEVICE" ]]; then
    # Truncate to 8 characters with dots
    if [ ${#BT_DEVICE} -gt 8 ]; then
      BT_DEVICE="${BT_DEVICE:0:8}.."
    fi
    sketchybar --set bluetooth label="$BT_DEVICE" drawing=on
  else
    sketchybar --set bluetooth drawing=off
  fi
else
  sketchybar --set bluetooth drawing=off
fi
'

# Next Meeting (leftmost right-side item)
sketchybar --add item meeting right \
           --set meeting update_freq=60 \
                        icon=📅 \
                        icon.font="SF Pro:Regular:14.0" \
                        label.font="SF Pro:Regular:13.0" \
                        script='
# Get next upcoming meeting using icalBuddy
NEXT_MEETING=$(icalBuddy -nc -nrd -ea -n -npn -li 1 \
  -iep "datetime" -df "" -tf "%H:%M" -b "" \
  eventsToday 2>/dev/null | head -1 | sed "s/^[[:space:]]*//" | sed "s/\x1b\[[0-9;]*m//g")

if [[ -z "$NEXT_MEETING" ]]; then
  sketchybar --set meeting label="None" label.color="0xff000000" icon.color="0xff000000"
else
  # Parse the start time (format: HH:MM - HH:MM)
  START_TIME=$(echo "$NEXT_MEETING" | grep -oE "^[0-9]{2}:[0-9]{2}")

  if [[ -n "$START_TIME" ]]; then
    # Calculate minutes until meeting
    NOW_EPOCH=$(date +%s)
    MEETING_EPOCH=$(date -j -f "%H:%M" "$START_TIME" +%s 2>/dev/null)

    if [[ -n "$MEETING_EPOCH" ]] && [[ $MEETING_EPOCH -gt $NOW_EPOCH ]]; then
      MINS_LEFT=$(( (MEETING_EPOCH - NOW_EPOCH) / 60 ))

      if [[ $MINS_LEFT -le 10 ]]; then
        # Red - meeting in 10 min or less
        COLOR="0xffcc0000"
        LABEL="${MINS_LEFT}m"
      elif [[ $MINS_LEFT -le 15 ]]; then
        # Orange - meeting in 15 min or less
        COLOR="0xffcc6600"
        LABEL="${MINS_LEFT}m"
      elif [[ $MINS_LEFT -le 60 ]]; then
        LABEL="${MINS_LEFT}m"
        COLOR="0xff000000"
      else
        HOURS=$(( MINS_LEFT / 60 ))
        REMAINING_MINS=$(( MINS_LEFT % 60 ))
        LABEL="${HOURS}h${REMAINING_MINS}m"
        COLOR="0xff000000"
      fi
      sketchybar --set meeting label="$LABEL" label.color="$COLOR" icon.color="$COLOR"
    else
      # Meeting time has passed, check if there are more today
      FUTURE=$(icalBuddy -nc -nrd -n -npn -li 1 \
        -iep "datetime" -df "" -tf "%H:%M" -b "" \
        -eed eventsToday 2>/dev/null | head -1 | sed "s/^[[:space:]]*//" | sed "s/\x1b\[[0-9;]*m//g")
      if [[ -z "$FUTURE" ]]; then
        sketchybar --set meeting label="Done" label.color="0xff000000" icon.color="0xff000000"
      else
        FSTART=$(echo "$FUTURE" | grep -oE "^[0-9]{2}:[0-9]{2}")
        if [[ -n "$FSTART" ]]; then
          FEPOCH=$(date -j -f "%H:%M" "$FSTART" +%s 2>/dev/null)
          if [[ -n "$FEPOCH" ]] && [[ $FEPOCH -gt $NOW_EPOCH ]]; then
            FMINS=$(( (FEPOCH - NOW_EPOCH) / 60 ))
            if [[ $FMINS -le 10 ]]; then
              COLOR="0xffcc0000"
            elif [[ $FMINS -le 15 ]]; then
              COLOR="0xffcc6600"
            else
              COLOR="0xff000000"
            fi
            if [[ $FMINS -le 60 ]]; then
              LABEL="${FMINS}m"
            else
              HOURS=$(( FMINS / 60 ))
              REMAINING_MINS=$(( FMINS % 60 ))
              LABEL="${HOURS}h${REMAINING_MINS}m"
            fi
            sketchybar --set meeting label="$LABEL" label.color="$COLOR" icon.color="$COLOR"
          else
            sketchybar --set meeting label="Done" label.color="0xff000000" icon.color="0xff000000"
          fi
        else
          sketchybar --set meeting label="Done" label.color="0xff000000" icon.color="0xff000000"
        fi
      fi
    fi
  else
    sketchybar --set meeting label="Today" label.color="0xff000000" icon.color="0xff000000"
  fi
fi
'

# Subscribe to events
sketchybar --subscribe front_app window_focus windows_on_spaces

# Force update all items on start
sketchybar --update

# Trigger initial front_app update
sketchybar --trigger window_focus

echo "sketchybar configuration loaded"